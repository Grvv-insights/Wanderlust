<%- layout("/layouts/boilerplate.ejs") %>

<body>
    <!-- CARD SECTION -->
    <div class="d-flex flex-column align-items-center text-center py-4">
        <h2 class="h4 fw-bold mb-3"><%= list.title %></h2>

        <% const imageUrl = list.image && list.image.url ? list.image.url : 'https://img.magnific.com/free-vector/glitch-error-404-page_23-2148105404.jpg?semt=ais_hybrid&w=740&q=80'; %>

        <img
            src="<%= imageUrl %>"
            alt="Listing image"
            class="rounded mb-4"
            style="width:90%; max-width:600px; height:18rem; object-fit:cover; border-radius:1rem;"
        />

        <div class="w-100" style="max-width:600px;">
            <p class="mb-3"><i>Owned by: <%= list.owner.username%></i></p>
            <p class="mb-3"><%= list.description %></p>
            <p class="mb-2">
                <strong>Price:</strong> 
                <span class="price-display" data-base-price="<%= list.price %>">₹<%= list.price %>/night</span>
            </p>
            <p class="mb-2"><strong>Location:</strong> <%= list.location %></p>
            <p class="mb-2"><strong>Country:</strong> <%= list.country %></p>
        </div>

    <!-- LISTING BUTTONS -->
    <div
        class="d-flex flex-column flex-md-row gap-2 mt-4 justify-content-center w-100"
        style="max-width:700px;"
    >
        <form action="/listings" method="GET" class="m-0">
            <button class="btn btn-outline-secondary">Back</button>
        </form>

        <% if(currUser && currUser._id.equals(list.owner._id)){%>
        <form action="/listings/<%= list._id %>/edit" method="GET" class="m-0">
            <button class="btn btn-outline-primary">Edit</button>
        </form>

        <form
            action="/listings/<%= list._id %>?_method=DELETE"
            method="POST"
            class="m-0"
        >
            <button class="btn btn-outline-danger">Delete</button>
        </form>
        <%} %>
    </div>

    <!-- MAP SECTION -->
    <div class="w-100 d-flex justify-content-center mt-4">
        <div style="max-width:720px; width:100%;">
            <h3 class="review-heading mb-3">Where you'll be</h3>

            <% if (list.geometry && list.geometry.coordinates && list.geometry.coordinates.length === 2) { %>
                <div 
                    id="map" 
                    data-lat="<%= list.geometry.coordinates[1] %>"
                    data-lon="<%= list.geometry.coordinates[0] %>"
                    data-location="<%= list.location %>, <%= list.country %>"
                    style="width: 100%; height: 300px; border-radius: 1rem;"
                ></div>
            <% } else { %>
                <p class="text-center text-muted mt-3">Map not available for this listing.</p>
            <% } %>
        </div>
    </div>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="/js/map.js"></script>

    <!-- COMMENT FORM -->
    <div class="w-100 d-flex justify-content-center mt-3">
        <div class="comment-form-card" style="max-width:720px; width:100%;">
            <h2 class="comment-form-title">Leave a Comment</h2>

            <form action="/listings/<%= list._id %>/reviews" method="POST" class="needs-validation" novalidate>
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>
                        <fieldset class="starability-coinFlip">
                        <legend>First rating:</legend>
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" required />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
</div>

                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control comment-textarea" required></textarea>
                    <div class="invalid-feedback">Please add some comments for review</div>
                </div>

                <button class="btn btn-dark mt-3" type="submit">Submit</button>
            </form>
        </div>
    </div>

    <!-- REVIEW SECTION -->
    <div class="w-100 d-flex justify-content-center mt-3">
        <div
            class="review-section"
            style="max-width:720px; width:100%;">

            <div class="review-divider"></div>
            <h3 class="review-heading">All Reviews</h3>

            <div class="review-list">
                <% for(const review of list.reviews){ %>
                    <div class="card review-card shadow-sm">

                        <div class="card-body">
                            <div class="review-card-header mb-2">
                                <h5 class="card-title mb-0">Review by <%= review.author ? review.author.username : "Anonymous" %></h5>
                            </div>
                            
                            <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                            <p class="card-text review-comment"><%= review.comment %></p>

                            <% if(currUser && currUser._id.equals(review.author._id)){ %>
                            <form action="/listings/<%= list._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                                <button type="submit" class="btn btn-sm btn-outline-danger mt-2">Delete</button>
                            </form>
                            <% } %>
                        </div>

                    </div>

                <% } %>

            </div>

        </div>

    </div>

    </div>

</body>

</html>