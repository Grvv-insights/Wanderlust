<%- layout("/layouts/boilerplate.ejs") %>

<div class="d-flex justify-content-center align-items-center min-vh-75">
  <div class="w-100" style="max-width: 700px">
    <h2 class="text-center mb-4">Edit Your Listing</h2>

    <form
      action="/listings/<%= list._id %>?_method=PUT"
      method="post"
      class="mx-auto needs-validation"
      novalidate
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="title" class="form-label">Title:</label>
        <input
          id="title"
          name="listing[title]"
          type="text"
          value="<%= list.title %>"
          class="form-control"
          required
        />
        <div class="valid-feedback">Title looks good</div>
        <div class="invalid-feedback">Fill the Title</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description:</label>
        <textarea
          id="description"
          name="listing[description]"
          class="form-control"
          rows="2"
          required
        ><%= list.description %></textarea>
        <div class="valid-feedback">Description looks good</div>
        <div class="invalid-feedback">Fill the Description</div>
      </div>

      <!-- Optional File Upload during Edit -->
      <div class="mb-3">
        <label for="image" class="form-label">Upload New Image (Optional):</label>
        <input
          id="image"
          name="listing[image]"
          type="file"
          class="form-control"
        />
        <div class="valid-feedback">Image field looks good</div>
      </div>

      <!-- Category Dropdown Select -->
      <div class="mb-3">
        <label for="category" class="form-label">Category:</label>
        <select
          id="category"
          name="listing[category]"
          class="form-select"
          required
        >
          <option value="" disabled>Select Category</option>
          <option value="trending" <%= list.category === 'trending' ? 'selected' : '' %>>Trending</option>
          <option value="rooms" <%= list.category === 'rooms' ? 'selected' : '' %>>Rooms</option>
          <option value="iconic-cities" <%= list.category === 'iconic-cities' ? 'selected' : '' %>>Iconic Cities</option>
          <option value="mountains" <%= list.category === 'mountains' ? 'selected' : '' %>>Mountains</option>
          <option value="castles" <%= list.category === 'castles' ? 'selected' : '' %>>Castles</option>
          <option value="pools" <%= list.category === 'pools' ? 'selected' : '' %>>Pools</option>
          <option value="camping" <%= list.category === 'camping' ? 'selected' : '' %>>Camping</option>
          <option value="farms" <%= list.category === 'farms' ? 'selected' : '' %>>Farms</option>
          <option value="arctic" <%= list.category === 'arctic' ? 'selected' : '' %>>Arctic</option>
          <option value="domes" <%= list.category === 'domes' ? 'selected' : '' %>>Domes</option>
          <option value="boats" <%= list.category === 'boats' ? 'selected' : '' %>>Boats</option>
        </select>
        <div class="valid-feedback">Category selected</div>
        <div class="invalid-feedback">Please select a category</div>
      </div>

      <div class="mb-3">
        <label for="price" class="form-label">Price:</label>
        <input
          id="price"
          name="listing[price]"
          value="<%= list.price %>"
          type="number"
          class="form-control"
          required
        />
        <div class="valid-feedback">Price looks good</div>
        <div class="invalid-feedback">Enter a valid price</div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location:</label>
        <input
          id="location"
          name="listing[location]"
          value="<%= list.location %>"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">Perfect Location</div>
        <div class="invalid-feedback">Fill the Location</div>
      </div>

      <div class="mb-3">
        <label for="country" class="form-label">Country:</label>
        <input
          id="country"
          name="listing[country]"
          value="<%= list.country %>"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">Country looks good</div>
        <div class="invalid-feedback">Fill the Country</div>
      </div>

      <button
        type="submit"
        class="btn text-white w-100"
        style="background-color: #ff5a5f; border-color: #ff5a5f"
      >
        Edit Listing
      </button>
    </form>
  </div>
</div>