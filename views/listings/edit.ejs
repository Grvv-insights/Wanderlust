<%- layout("/layouts/boilerplate.ejs") %>

<div class="d-flex justify-content-center align-items-center min-vh-75">
  <div class="w-100" style="max-width: 700px">
    <h2 class="text-center mb-4">Edit Your Listing</h2>

    <form
      action="/listings/<%= list._id %>?_method=PUT"
      method="post"
      class="mx-auto needs-validation"
      novalidate
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="title" class="form-label">Title:</label>
        <input
          id="title"
          name="listing[title]"
          type="text"
          value="<%= list.title %>"
          class="form-control"
          required
        />
        <div class="valid-feedback">Title looks good</div>
        <div class="invalid-feedback">Fill the Title</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description:</label>
        <textarea
          id="description"
          name="listing[description]"
          class="form-control"
          rows="2"
          required
        ><%= list.description %></textarea>
        <div class="valid-feedback">Description looks good</div>
        <div class="invalid-feedback">Fill the Description</div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Upload Image:</label>
        <input
          id="image"
          name="listing[image]"
          value="<%= list.image.url %>"
          type="file"
          class="form-control"
          required
        />
        <div class="valid-feedback">Image URL looks good</div>
        <div class="invalid-feedback">Fill the Image URL</div>
      </div>

      <div class="mb-3">
        <label for="price" class="form-label">Price:</label>
        <input
          id="price"
          name="listing[price]"
          value="<%= list.price %>"
          type="number"
          class="form-control"
          required
        />
        <div class="valid-feedback">Price looks good</div>
        <div class="invalid-feedback">Enter a valid price</div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location:</label>
        <input
          id="location"
          name="listing[location]"
          value="<%= list.location %>"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">Perfect Location</div>
        <div class="invalid-feedback">Fill the Location</div>
      </div>

      <div class="mb-3">
        <label for="country" class="form-label">Country:</label>
        <input
          id="country"
          name="listing[country]"
          value="<%= list.country %>"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">Country looks good</div>
        <div class="invalid-feedback">Fill the Country</div>
      </div>

      <button
        type="submit"
        class="btn text-white w-100"
        style="background-color: #ff5a5f; border-color: #ff5a5f"
      >
        Edit Listing
      </button>
    </form>
  </div>
</div>